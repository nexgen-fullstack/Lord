<?xml version="1.0" encoding="utf-8"?>
<!-- The foreground is the site's maskable icon: the cross already sits inside
     the safe zone, so every launcher mask — circle, squircle, teardrop — keeps
     it whole. The PNGs are drawn by android/build.js from src/icons.js. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ink" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
